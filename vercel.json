    { "source": "/mina-checklistor", "destination": "/index.html" },
    { "source": "/mina-checklistor/", "destination": "/index.html" },
    { "source": "/aktier/:path*", "destination": "/index.html" },
    { "source": "/aktier/:path*/", "destination": "/index.html" },
    { "source": "/guider", "destination": "/index.html" },
    { "source": "/guider/", "destination": "/index.html" },
    { "source": "/guider/:path*", "destination": "/index.html" },
    { "source": "/guider/:path*/", "destination": "/index.html" },
    { "source": "/borsskolan/:path*", "destination": "/index.html" },
    { "source": "/borsskolan/:path*/", "destination": "/index.html" },
    { "source": "/skola", "destination": "/index.html" },
    { "source": "/skola/", "destination": "/index.html" },
    { "source": "/marknad", "destination": "/index.html" },
    { "source": "/marknad/", "destination": "/index.html" },
    { "source": "/kontakt", "destination": "/index.html" },
    { "source": "/kontakt/", "destination": "/index.html" },
    { "source": "/villkor", "destination": "/index.html" },
    { "source": "/villkor/", "destination": "/index.html" },
    { "source": "/integritet", "destination": "/index.html" },
    { "source": "/integritet/", "destination": "/index.html" },
    { "source": "/innehav", "destination": "/index.html" },
    { "source": "/innehav/", "destination": "/index.html" },
    { "source": "/intressekonflikter", "destination": "/index.html" },
    { "source": "/intressekonflikter/", "destination": "/index.html" },
    { "source": "/aktieinnehav-och-intressekonflikter", "destination": "/index.html" },
    { "source": "/aktieinnehav-och-intressekonflikter/", "destination": "/index.html" },
    { "source": "/verktyg", "destination": "/index.html" },
    { "source": "/verktyg/", "destination": "/index.html" },
    { "source": "/verktyg/:path*", "destination": "/index.html" },

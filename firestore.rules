rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "carl.fredrik.thor@gmail.com" && request.auth.token.email_verified == true));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.keys().hasAll(['uid', 'email']);
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email']);

      match /savingsGoals/{goalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.uid == userId;
        allow update: if isOwner(userId) &&
          (!resource.data.keys().hasAny(['uid']) || resource.data.uid == userId) &&
          (!request.resource.data.keys().hasAny(['uid']) || request.resource.data.uid == userId);
        allow delete: if isOwner(userId) &&
          (!resource.data.keys().hasAny(['uid']) || resource.data.uid == userId);

        match /capitalHistory/{entryId} {
          allow read, create: if isOwner(userId);
        }
      }

      match /householdMonths/{monthId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$') &&
          request.resource.data.keys().hasOnly(['calleSalary', 'idaSalary', 'benefit', 'childAllowance', 'liquidSavings', 'childrenInvested', 'callePension', 'idaPension', 'otherInvested', 'updatedAt']) &&
          request.resource.data.keys().hasAll(['calleSalary', 'idaSalary', 'benefit', 'childAllowance', 'liquidSavings', 'childrenInvested', 'callePension', 'idaPension', 'otherInvested', 'updatedAt']) &&
          request.resource.data.calleSalary is number && request.resource.data.calleSalary >= 0 && request.resource.data.calleSalary <= 100000000 &&
          request.resource.data.idaSalary is number && request.resource.data.idaSalary >= 0 && request.resource.data.idaSalary <= 100000000 &&
          request.resource.data.benefit is number && request.resource.data.benefit >= 0 && request.resource.data.benefit <= 100000000 &&
          request.resource.data.childAllowance is number && request.resource.data.childAllowance >= 0 && request.resource.data.childAllowance <= 100000000 &&
          (request.resource.data.liquidSavings == null || (request.resource.data.liquidSavings is number && request.resource.data.liquidSavings >= 0 && request.resource.data.liquidSavings <= 100000000)) &&
          request.resource.data.childrenInvested is number && request.resource.data.childrenInvested >= 0 && request.resource.data.childrenInvested <= 100000000 &&
          request.resource.data.callePension is number && request.resource.data.callePension >= 0 && request.resource.data.callePension <= 100000000 &&
          request.resource.data.idaPension is number && request.resource.data.idaPension >= 0 && request.resource.data.idaPension <= 100000000 &&
          request.resource.data.otherInvested is number && request.resource.data.otherInvested >= 0 && request.resource.data.otherInvested <= 100000000;
      }
    }

    // Watchlists
    match /watchlists/{docId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Stock Sentiment (Aggregated)
    match /stock_sentiment/{stockSlug} {
      allow read: if true;
      allow write: if isAdmin(); // Endast admins kan skriva, för att förhindra obehörig modifiering
    }

    // User Votes
    match /user_votes/{voteId} {
      // voteId format: userId_stockSlug
      allow read: if true;
      allow create: if isAuthenticated() && voteId.startsWith(request.auth.uid + "_");
      allow update: if isOwner(voteId.split("_")[0]);
      allow delete: if isOwner(voteId.split("_")[0]);
    }

    // Comments
    match /comments/{commentId} {
      function isValidComment() {
        return request.resource.data.keys().hasAll(['userId', 'userName', 'stockSlug', 'content', 'createdAt']) &&
               request.resource.data.userId == request.auth.uid &&
               request.resource.data.content is string &&
               request.resource.data.content.size() > 0 &&
               request.resource.data.content.size() < 1000;
      }
      allow read: if true;
      allow create: if isAuthenticated() && isValidComment();
      allow update: if isOwner(resource.data.userId) && isValidComment();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Newsletter Subscriptions
    match /newsletter_subscriptions/{email} {
      allow create: if request.resource.data.keys().hasAll(['email', 'createdAt']) &&
                      request.resource.data.email == email &&
                      request.resource.data.email is string &&
                      request.resource.data.email.size() > 0 &&
                      request.resource.data.email.size() < 255;
      allow read, update, delete: if isAdmin();
    }
  }
}
